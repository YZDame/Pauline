---
interface Props {
  base: string;
  section?: string;
}

const { base, section = "home" } = Astro.props;
const items = [
  { id: "home", label: "首页", href: base },
  { id: "timeline", label: "时间线", href: `${base}timeline/` },
  { id: "series", label: "系列线", href: `${base}series/` },
  { id: "gallery", label: "照片墙", href: `${base}gallery/` },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="wordmark" href={base} aria-label="宝莲图鉴首页">
      <span>宝莲图鉴</span>
      <span class="wordmark-en">Pauline Archive</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {items.map((item) => (
        <a href={item.href} class={section === item.id ? "is-active" : undefined} aria-current={section === item.id ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深色模式">深色</button>
      <details class="mobile-nav" data-mobile-nav>
        <summary>菜单</summary>
        <nav aria-label="移动端主导航">
          {items.map((item) => (
            <a href={item.href} class={section === item.id ? "is-active" : undefined} aria-current={section === item.id ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
