---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterSelect from "../components/FilterSelect.astro";
import catalogData from "../data/catalog.json";
import { dateLabel, versionLabel } from "../lib/work-labels";
import { shortWorkLabel, workSearchText } from "../lib/archive";
import type { CatalogItem } from "../types";
import { pageContext, localizeWork } from "../lib/i18n";

const { locale, base, assetBase, t } = pageContext(Astro.url);

const works = (catalogData as CatalogItem[]).map((work) => localizeWork(work, locale));
const searchText = new Map((catalogData as CatalogItem[]).map((work) => [
  work.id, `${workSearchText(work)} ${workSearchText(localizeWork(work, "en"))}`,
]));

const years = [...new Set(works.map((work) => work.year).filter(Boolean))] as string[];
years.sort();
const collectionOrder = ["Trigonometric Function", "PLY", "Basketball", "BNU", "Cambridge", "Graduation"];
---

<BaseLayout title={t("照片墙")} description={t("搜索并筛选宝莲图鉴全部 88 件作品，保留快速照片墙预览。")} section="gallery">
  <section class="gallery-hero section-frame" aria-labelledby="gallery-title">
    <div class="gallery-title-row">
      <h1 id="gallery-title" data-enter>{t("全部作品")}</h1>
    </div>

    <form class="gallery-filters" action={`${base}gallery/`} method="get" data-gallery-filters data-ui data-enter>
      <label class="search-field"><span>{t("搜索")}</span><input type="search" name="q" placeholder={t("代号、系列或作品名称")} autocomplete="off" data-search-filter /></label>
      <FilterSelect name="catalog" label="册次" options={[
        { value: "", label: "全部四册" },
        ...[1, 2, 3, 4].map((number) => ({ value: String(number), label: locale === "en" ? `Volume ${number}` : `宝莲图鉴 ${number}` })),
      ]} />
      <FilterSelect name="year" label="年份" options={[
        { value: "", label: "全部年份" },
        ...years.map((year) => ({ value: year, label: year })),
        { value: "undated", label: "日期未详" },
      ]} />
      <FilterSelect name="group" label="系列与支线" options={[
        { value: "", label: "全部系列与支线" },
        ...collectionOrder.map((name) => ({ value: name, label: name, group: "系列" })),
        { value: "branch:main", label: "正代", group: "创作线" },
        { value: "branch:Sheett", label: "Sheett", group: "创作线" },
        { value: "branch:5XD", label: "5XD", group: "创作线" },
      ]} />
      <button class="filter-reset" type="reset" data-reset>{t("重置")}</button>
    </form>
  </section>

  <section class="gallery-index section-frame" aria-labelledby="wall-title">
    <div class="gallery-heading">
      <h2 id="wall-title">{t("作品照片墙")}</h2>
      <p role="status" aria-live="polite"><span data-result-count>{works.length}</span> <span data-result-unit>{locale === "en" ? "works" : "件作品"}</span></p>
    </div>

    <div class="work-grid">
      {works.map((work) => (
        <a
          class="work-card"
          href={`${base}works/${work.id}/`}
          aria-label={`${locale === "en" ? "Preview" : "预览"} ${versionLabel(work)}`}
          data-work
          data-search={searchText.get(work.id)}
          data-catalog-number={work.catalogNumber}
          data-year={work.year ?? "undated"}
          data-series={work.collection.join("|")}
          data-branch={work.branch ?? "main"}
          data-version={versionLabel(work)}
          data-date={dateLabel(work.creationDate, locale)}
          data-image={`${assetBase}${work.image}`}
          data-url={`${base}works/${work.id}/`}
          data-catalog={work.catalog}
        >
          <span class="work-card-image"><img src={`${assetBase}${work.thumbnail}`} alt={versionLabel(work)} width="720" height="540" loading="lazy" decoding="async" /></span>
          <span class="work-card-meta">
            <strong>{shortWorkLabel(work)}</strong>
            {work.code.length > 0 && <span>{work.code.join(" · ")}</span>}
            <span class="work-card-subline"><span>{work.catalog}</span><time datetime={work.creationDate ?? undefined}>{dateLabel(work.creationDate, locale)}</time></span>
          </span>
        </a>
      ))}
    </div>

    <div class="gallery-empty" data-gallery-empty hidden>
      <h3>{t("没有符合条件的作品")}</h3>
      <button class="button" type="button" data-empty-reset>{t("清除筛选")}</button>
    </div>
  </section>

  <dialog class="work-dialog" aria-labelledby="dialog-version">
    <button class="dialog-close" type="button" aria-label={t("关闭预览")} data-dialog-close>{t("关闭")}</button>
    <div class="dialog-layout">
      <img class="dialog-image" src={`${assetBase}${works[0].image}`} alt="" width="1600" height="1200" />
      <div class="dialog-copy">
        <span id="dialog-catalog"></span>
        <h2 id="dialog-version"></h2>
        <time id="dialog-date"></time>
        <a class="button" id="dialog-link" href={`${base}works/${works[0].id}/`}>{t("查看完整作品")}</a>
      </div>
    </div>
  </dialog>

  <script>
    import { gsap } from "gsap";
    import { initializeFilterSelects } from "../scripts/filter-select";

    const form = document.querySelector<HTMLFormElement>("[data-gallery-filters]");
    const search = document.querySelector<HTMLInputElement>("[data-search-filter]");
    const catalog = document.querySelector<HTMLSelectElement>("[data-catalog-filter]");
    const year = document.querySelector<HTMLSelectElement>("[data-year-filter]");
    const group = document.querySelector<HTMLSelectElement>("[data-group-filter]");
    const cards = [...document.querySelectorAll<HTMLAnchorElement>("[data-work]")];
    const count = document.querySelector<HTMLElement>("[data-result-count]");
    const unit = document.querySelector<HTMLElement>("[data-result-unit]");
    const empty = document.querySelector<HTMLElement>("[data-gallery-empty]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const params = new URLSearchParams(location.search);
    if (search) search.value = params.get("q") ?? "";
    if (catalog) catalog.value = params.get("catalog") ?? "";
    if (year) year.value = params.get("year") ?? "";
    if (group) group.value = params.get("branch") ? `branch:${params.get("branch")}` : (params.get("series") ?? "");

    if (form) initializeFilterSelects(form);

    function applyFilters(animate = false, updateUrl = true) {
      const query = search?.value.trim().toLocaleLowerCase() ?? "";
      const selectedCatalog = catalog?.value ?? "";
      const selectedYear = year?.value ?? "";
      const selectedGroup = group?.value ?? "";
      const visible = cards.filter((card) => {
        const matchesQuery = !query || (card.dataset.search ?? "").includes(query);
        const matchesCatalog = !selectedCatalog || card.dataset.catalogNumber === selectedCatalog;
        const matchesYear = !selectedYear || card.dataset.year === selectedYear;
        const matchesGroup = !selectedGroup || (selectedGroup.startsWith("branch:")
          ? card.dataset.branch === selectedGroup.slice(7)
          : (card.dataset.series ?? "").split("|").includes(selectedGroup));
        const matches = matchesQuery && matchesCatalog && matchesYear && matchesGroup;
        card.hidden = !matches;
        return matches;
      });

      if (count) count.textContent = String(visible.length);
      if (unit && document.documentElement.lang === "en") unit.textContent = visible.length === 1 ? "work" : "works";
      if (empty) empty.hidden = visible.length > 0;

      if (updateUrl) {
        const next = new URLSearchParams();
        if (query) next.set("q", search?.value.trim() ?? "");
        if (selectedCatalog) next.set("catalog", selectedCatalog);
        if (selectedYear) next.set("year", selectedYear);
        if (selectedGroup.startsWith("branch:")) next.set("branch", selectedGroup.slice(7));
        else if (selectedGroup) next.set("series", selectedGroup);
        const suffix = next.size ? `?${next}` : location.pathname;
        history.replaceState(null, "", suffix);
      }

      if (animate && !reduced.matches && visible.length) {
        gsap.fromTo(visible.slice(0, 28), { opacity: 0.35, y: 8 }, { opacity: 1, y: 0, duration: 0.28, stagger: 0.018, ease: "power2.out", clearProps: "opacity,transform", overwrite: true });
      }
    }

    search?.addEventListener("input", () => applyFilters(false));
    [catalog, year, group].forEach((control) => control?.addEventListener("change", () => applyFilters(true)));
    form?.addEventListener("submit", (event) => { event.preventDefault(); applyFilters(false); });
    form?.addEventListener("reset", () => window.setTimeout(() => applyFilters(true), 0));
    document.querySelector("[data-empty-reset]")?.addEventListener("click", () => form?.reset());
    applyFilters(false, false);

    const dialog = document.querySelector<HTMLDialogElement>(".work-dialog");
    const dialogImage = dialog?.querySelector<HTMLImageElement>(".dialog-image");
    const dialogVersion = dialog?.querySelector<HTMLElement>("#dialog-version");
    const dialogDate = dialog?.querySelector<HTMLTimeElement>("#dialog-date");
    const dialogCatalog = dialog?.querySelector<HTMLElement>("#dialog-catalog");
    const dialogLink = dialog?.querySelector<HTMLAnchorElement>("#dialog-link");

    cards.forEach((card) => {
      card.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        if (!dialog || !dialogImage || !dialogVersion || !dialogDate || !dialogCatalog || !dialogLink) return;
        event.preventDefault();
        dialogImage.src = card.dataset.image ?? "";
        dialogImage.alt = card.dataset.version ?? "";
        dialogVersion.textContent = card.dataset.version ?? "";
        dialogDate.textContent = card.dataset.date ?? "";
        dialogCatalog.textContent = card.dataset.catalog ?? "";
        dialogLink.href = card.dataset.url ?? "";
        dialog.showModal();
        if (!reduced.matches) {
          const settle = () => gsap.set(dialog, { clearProps: "opacity,transform" });
          gsap.fromTo(dialog, { opacity: 0, y: 16, scale: 0.985 }, { opacity: 1, y: 0, scale: 1, duration: 0.32, ease: "power2.out", clearProps: "opacity,transform", onInterrupt: settle });
          gsap.fromTo(dialog.querySelectorAll(".dialog-copy > *"), { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.3, stagger: 0.04, delay: 0.08, ease: "power2.out", clearProps: "opacity,transform" });
          window.setTimeout(() => { if (dialog.open) settle(); }, 520);
        }
      });
    });

    const closeDialog = () => {
      if (!dialog?.open) return;
      const settle = () => {
        if (!dialog.open) return;
        dialog.close();
        gsap.set(dialog, { clearProps: "opacity,transform" });
      };
      if (reduced.matches) {
        settle();
        return;
      }
      gsap.to(dialog, { opacity: 0, y: 10, scale: 0.99, duration: 0.18, ease: "power1.in", onComplete: settle, onInterrupt: settle });
      window.setTimeout(settle, 420);
    };

    dialog?.querySelector("[data-dialog-close]")?.addEventListener("click", closeDialog);
    dialog?.addEventListener("cancel", (event) => { event.preventDefault(); closeDialog(); });
    dialog?.addEventListener("click", (event) => { if (event.target === dialog) closeDialog(); });
  </script>
</BaseLayout>
