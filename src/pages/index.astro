---
import BaseLayout from "../layouts/BaseLayout.astro";
import catalogData from "../data/catalog.json";
import { dateLabel, versionLabel } from "../lib/work-labels";
import { dateRange, seriesAnchor, shortWorkLabel, yearRange } from "../lib/archive";
import type { CatalogItem } from "../types";

const works = catalogData as CatalogItem[];
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const representativeIds = ["b1-01", "b2-04", "b3-05", "b4-18"];
const volumeNames = ["第一册", "第二册", "第三册", "第四册"];
const volumeDescriptions = [
  "从 Pauline I 开始，正代与 Sheett、5XD 两条支线在第一册中并行出现。",
  "从 ZH1Z 到三角函数系列，作品代号与主题在这一册明显扩展。",
  "PLY、Basketball 与多件独立命名作品，延续至 2020 年的创作节点。",
  "BNU 构成这一册的主线，并与 Cambridge、Graduation 两组作品相连。",
];
const volumes = representativeIds.map((id, index) => {
  const catalogNumber = index + 1;
  const items = works.filter((work) => work.catalogNumber === catalogNumber);
  return {
    catalogNumber,
    name: volumeNames[index],
    description: volumeDescriptions[index],
    items,
    hero: works.find((work) => work.id === id)!,
    range: yearRange(items),
  };
});
const initial = volumes[0].hero;
const selectedIds = ["b1-01", "b1-18", "b2-04", "b2-05", "b3-05", "b3-09", "b4-12", "b4-15"];
const selectedWorks = selectedIds.map((id) => works.find((work) => work.id === id)!);
const collectionOrder = ["Trigonometric Function", "PLY", "Basketball", "BNU", "Cambridge", "Graduation"];
const collections = collectionOrder.map((name) => ({
  name,
  items: works.filter((work) => work.collection.includes(name)),
}));
const collectionNotes: Record<string, string> = {
  "Trigonometric Function": "9 件作品，以希腊字母与符号命名，集中在 2018 年 4–6 月。",
  "PLY": "PLY ONE、PLY 0.7A 与 PLY ZERO，三件作品均记录于 2018 年 11 月。",
  "Basketball": "Under Armour SC IV 与 Air Jordan，跨越 2018 与 2019 年。",
  "BNU": "18 件作品，从 2020 年延伸至 2024 年，并连接 Cambridge 与 Graduation。",
  "Cambridge": "3 件同日记录的作品，同时归入 BNU。",
  "Graduation": "当前时间线的最新作品，同时归入 BNU。",
};
---

<BaseLayout section="home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-card">
      <div class="hero-register" data-enter>
        <span>Pauline Archive</span>
        <span id="hero-catalog">{initial.catalog}</span>
      </div>
      <h1 id="home-title" data-enter>宝莲图鉴</h1>
      <p class="hero-lead" data-enter>四册、八十八件鞋履手稿，从 2017 年的第一双到 2024 年的毕业篇。</p>

      <a class="hero-specimen" id="hero-work-link" href={`${base}works/${initial.id}/`} data-enter aria-label={`查看 ${versionLabel(initial)}`}>
        <span class="hero-specimen-drift" data-parallax>
          <img id="hero-work-image" src={`${base}${initial.image}`} alt={versionLabel(initial)} width="1600" height="1200" fetchpriority="high" />
        </span>
      </a>

      <div class="hero-work-meta" id="hero-work-meta" data-enter>
        <a id="hero-version" href={`${base}works/${initial.id}/`}>{shortWorkLabel(initial)}</a>
        <time id="hero-date" datetime={initial.creationDate ?? undefined}>{dateLabel(initial.creationDate)}</time>
      </div>

      <div class="hero-volume-switch" role="group" aria-label="切换四册代表作品" data-enter>
        {volumes.map((volume, index) => (
          <button
            type="button"
            data-volume={index}
            data-image={`${base}${volume.hero.image}`}
            data-title={versionLabel(volume.hero)}
            data-short-title={shortWorkLabel(volume.hero)}
            data-date={dateLabel(volume.hero.creationDate)}
            data-raw-date={volume.hero.creationDate ?? ""}
            data-url={`${base}works/${volume.hero.id}/`}
            data-catalog={volume.hero.catalog}
            aria-pressed={index === 0}
          >{volume.name}</button>
        ))}
      </div>
      <a class="button hero-cta" href={`${base}gallery/`} data-enter>进入照片墙</a>
    </div>
  </section>

  <section class="archive-intro section-frame" aria-labelledby="archive-intro-title" data-reveal-group>
    <div class="intro-heading">
      <h2 id="archive-intro-title" data-reveal>八十八件，四册归档</h2>
      <p data-reveal>每件作品保留原稿的日期精度、代际编号、支线与系列归属。这里不是一张静态封面，而是一套可进入的索引。</p>
    </div>
    <div class="archive-facts">
      <div data-reveal><strong>88</strong><span>件电子化作品</span></div>
      <div data-reveal><strong>4</strong><span>册原始图鉴</span></div>
      <div data-reveal><strong>2017–2024</strong><span>有日期作品的跨度</span></div>
      <div data-reveal><strong>2 + 6</strong><span>两条支线与六组系列</span></div>
    </div>
  </section>

  <section class="volume-section section-frame" id="volumes" aria-labelledby="volume-title">
    <div class="section-heading-row">
      <h2 id="volume-title">四册索引</h2>
      <p>每一册都是创作线上的一个档案卷。</p>
    </div>
    <div class="volume-stack">
      {volumes.map((volume, index) => (
        <article class={`volume-band volume-tone-${index + 1}`} style={`--volume-index:${index}`} data-reveal-group>
          <a class="volume-tab" href={`${base}gallery/?catalog=${volume.catalogNumber}`}>{volume.name}</a>
          <span class="volume-register">{volume.range} · {volume.items.length} 件</span>
          <div class="volume-band-inner">
            <a class="volume-image" href={`${base}works/${volume.hero.id}/`} data-reveal>
              <img src={`${base}${volume.hero.thumbnail}`} alt={versionLabel(volume.hero)} width="720" height="540" loading="lazy" decoding="async" />
            </a>
            <div class="volume-copy">
              <h3 data-reveal>{volume.hero.catalog}</h3>
              <p data-reveal>{volume.description}</p>
              <p class="volume-date-range" data-reveal>{dateRange(volume.items)}</p>
              <a class="text-link" href={`${base}gallery/?catalog=${volume.catalogNumber}`} data-reveal>浏览本册</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-series section-frame" aria-labelledby="home-series-title">
    <div class="series-display">
      <h2 id="home-series-title" data-reveal>系列</h2>
      <p data-reveal>系列按原稿记录归纳；共享作品会同时出现在多个系列中。</p>
      <a class="text-link" href={`${base}series/`} data-reveal>查看完整系列线</a>
    </div>
    <div class="series-accordion" data-reveal-group>
      {collections.map((collection, index) => (
        <details data-animate open={index === 0} data-reveal>
          <summary><span>{collection.name}</span><span>{collection.items.length} 件 <span aria-hidden="true">+</span></span></summary>
          <div class="details-content">
            <p>{collectionNotes[collection.name]}</p>
            <a href={`${base}series/#${seriesAnchor(collection.name)}`}>进入系列</a>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="selected-works section-frame" aria-labelledby="selected-title" data-reveal-group>
    <div class="section-heading-row">
      <h2 id="selected-title" data-reveal>作品选页</h2>
      <a class="text-link" href={`${base}gallery/`} data-reveal>查看全部 88 件</a>
    </div>
    <div class="selected-grid">
      {selectedWorks.map((work, index) => (
        <a class={`selected-work selected-tone-${index % 4}`} href={`${base}works/${work.id}/`} data-reveal>
          <span class="selected-image"><img src={`${base}${work.thumbnail}`} alt={versionLabel(work)} width="720" height="540" loading="lazy" decoding="async" /></span>
          <span class="selected-label">
            <span>{shortWorkLabel(work)}</span>
            <span>{work.catalog}</span>
            <time datetime={work.creationDate ?? undefined}>{dateLabel(work.creationDate)}</time>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-cta" aria-labelledby="home-cta-title" data-reveal-group>
    <p data-reveal>不必从第一页开始。<br />搜索一个代号，或从一双鞋进入整条创作线。</p>
    <div class="reply-card" data-reveal>
      <h2 id="home-cta-title">从任意一件开始</h2>
      <p>88 件作品都保留独立页面，也可以按册次、年份与系列筛选。</p>
      <a class="button" href={`${base}gallery/`}>打开全部作品</a>
    </div>
  </section>

  <script>
    import { gsap } from "gsap";

    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-volume]");
    const image = document.querySelector<HTMLImageElement>("#hero-work-image");
    const specimen = document.querySelector<HTMLAnchorElement>("#hero-work-link");
    const version = document.querySelector<HTMLAnchorElement>("#hero-version");
    const date = document.querySelector<HTMLTimeElement>("#hero-date");
    const catalog = document.querySelector<HTMLElement>("#hero-catalog");
    const meta = document.querySelector<HTMLElement>("#hero-work-meta");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!image || !specimen || !version || !date || !catalog || !meta || button.getAttribute("aria-pressed") === "true") return;
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));

        const update = () => {
          image.src = button.dataset.image ?? "";
          image.alt = button.dataset.title ?? "";
          specimen.href = button.dataset.url ?? "";
          specimen.setAttribute("aria-label", `查看 ${button.dataset.title ?? "作品"}`);
          version.href = button.dataset.url ?? "";
          version.textContent = button.dataset.shortTitle ?? "";
          date.textContent = button.dataset.date ?? "";
          date.dateTime = button.dataset.rawDate ?? "";
          catalog.textContent = button.dataset.catalog ?? "";
        };

        gsap.killTweensOf([image, meta]);
        if (reduced.matches) {
          update();
          gsap.set([image, meta], { clearProps: "opacity,transform" });
          return;
        }
        update();
        gsap.fromTo([image, meta], { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.32, ease: "power2.out", clearProps: "opacity,transform" });
      });
    });
  </script>
</BaseLayout>
