---
import BaseLayout from "../../layouts/BaseLayout.astro";
import catalogData from "../../data/catalog.json";
import { dateLabel, versionLabel, workStory } from "../../lib/work-labels";
import type { CatalogItem } from "../../types";

export function getStaticPaths() {
  const works = catalogData as CatalogItem[];
  return works.map((work, index) => ({
    params: { id: work.id },
    props: {
      work,
      previous: works[index - 1] ?? null,
      next: works[index + 1] ?? null,
    },
  }));
}

interface Props {
  work: CatalogItem;
  previous: CatalogItem | null;
  next: CatalogItem | null;
}

const { work, previous, next } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={work.title} description={work.title} image={`${base}${work.image}`}>
  <article class="work-detail">
    <a class="back-link" href={base} aria-label="返回全部作品">←</a>
    <img src={`${base}${work.image}`} alt={versionLabel(work)} width={work.width} height={work.height} />
    <div class="work-detail-copy">
      <h1>{versionLabel(work)}</h1>
      <time datetime={work.creationDate ?? undefined}>{dateLabel(work.creationDate)}</time>
      <p>{workStory(work)}</p>
    </div>
    <nav class="work-pagination" aria-label="作品翻页">
      {previous ? <a href={`${base}works/${previous.id}/`} aria-label={`上一件：${previous.title}`}>←</a> : <span />}
      {next ? <a href={`${base}works/${next.id}/`} aria-label={`下一件：${next.title}`}>→</a> : <span />}
    </nav>
  </article>
</BaseLayout>
