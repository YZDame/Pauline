---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageContext } from "../lib/i18n";

const { base, t } = pageContext(Astro.url);

---

<BaseLayout title={t("页面未找到")} section="other">
  <section class="not-found section-frame">
    <h1 data-enter>404</h1>
    <p data-enter>{t("这一页不在当前图鉴中。")}</p>
    <a class="button" href={base} data-enter>{t("返回宝莲图鉴")}</a>
  </section>
</BaseLayout>
