---
import BaseLayout from "../layouts/BaseLayout.astro";
import catalogData from "../data/catalog.json";
import { dateLabel, versionLabel, workStory } from "../lib/work-labels";
import type { CatalogItem } from "../types";

const works = catalogData as CatalogItem[];
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <h1 class="sr-only">宝莲图鉴</h1>
  <div class="work-grid">
    {works.map((work) => (
      <a
        class="work-card"
        href={`${base}works/${work.id}/`}
        aria-label={`查看 ${versionLabel(work)}`}
        data-work
        data-version={versionLabel(work)}
        data-date={dateLabel(work.creationDate)}
        data-story={workStory(work)}
        data-image={`${base}${work.image}`}
      >
        <span class="work-card-image">
          <img
            src={`${base}${work.thumbnail}`}
            alt={versionLabel(work)}
            width="720"
            height="540"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="work-card-meta">
          <span>{versionLabel(work)}</span>
          <time datetime={work.creationDate ?? undefined}>{dateLabel(work.creationDate)}</time>
        </span>
      </a>
    ))}
  </div>

  <dialog class="work-dialog" aria-labelledby="dialog-version" aria-describedby="dialog-story">
    <button class="dialog-close" type="button" aria-label="关闭">×</button>
    <img class="dialog-image" src="" alt="" width="1600" height="1200" />
    <div class="dialog-copy">
      <h2 id="dialog-version"></h2>
      <time id="dialog-date"></time>
      <p id="dialog-story"></p>
    </div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>(".work-dialog");
    const image = dialog?.querySelector<HTMLImageElement>(".dialog-image");
    const version = dialog?.querySelector<HTMLElement>("#dialog-version");
    const date = dialog?.querySelector<HTMLTimeElement>("#dialog-date");
    const story = dialog?.querySelector<HTMLElement>("#dialog-story");
    const close = dialog?.querySelector<HTMLButtonElement>(".dialog-close");

    document.querySelectorAll<HTMLAnchorElement>("[data-work]").forEach((card) => {
      card.addEventListener("click", (event) => {
        if (!dialog || !image || !version || !date || !story) return;
        event.preventDefault();
        image.src = card.dataset.image ?? "";
        image.alt = card.dataset.version ?? "";
        version.textContent = card.dataset.version ?? "";
        date.textContent = card.dataset.date ?? "";
        story.textContent = card.dataset.story ?? "";
        dialog.showModal();
      });
    });

    close?.addEventListener("click", () => dialog?.close());
  </script>
</BaseLayout>
