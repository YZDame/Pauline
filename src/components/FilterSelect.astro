---
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string; group?: string }[];
}
const { name, label, options } = Astro.props;
const id = `filter-${name}`;
---

<div class="filter-field" data-select>
  <label id={`${id}-label`} for={id}>{label}</label>
  <select id={id} name={name} {...{ [`data-${name}-filter`]: "" }}>
    {options.map((option) => <option value={option.value}>{option.label}</option>)}
  </select>
  <button class="select-trigger" type="button" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-controls={`${id}-options`} aria-labelledby={`${id}-label ${id}-value`} hidden>
    <span id={`${id}-value`} data-select-value>{options[0].label}</span>
    <svg class="select-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
  </button>
  <div class="select-menu" id={`${id}-options`} role="listbox" aria-labelledby={`${id}-label`} hidden>
    {options.map((option, index) => <>
      {option.group && option.group !== options[index - 1]?.group && <div class="select-group" role="presentation">{option.group}</div>}
      <div class="select-option" id={`${id}-option-${index}`} role="option" aria-selected={index === 0 ? "true" : "false"} data-value={option.value}>
        <span>{option.label}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
      </div>
    </>)}
  </div>
</div>
