---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  section?: "home" | "timeline" | "series" | "gallery" | "work" | "other";
}

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const {
  title = "宝莲图鉴",
  description = "宝莲图鉴，四册共 88 件鞋履手稿，记录 2017–2024 年的创作线。",
  image = `${base}og.png`,
  section = "other",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const pageTitle = title === "宝莲图鉴" ? title : `${title} · 宝莲图鉴`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png?v=shoe`} />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const saved = localStorage.getItem("pauline-theme");
        const theme = saved === "light" || saved === "dark" ? saved : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body class={`page-${section}`}>
    <a class="skip-link" href="#content">跳到内容</a>
    <SiteHeader base={base} section={section} />
    <div class="page-shell">
      <main id="content"><slot /></main>
    </div>
    <SiteFooter base={base} />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
