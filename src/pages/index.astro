---
import BaseLayout from "../layouts/BaseLayout.astro";
import catalogData from "../data/catalog.json";
import { dateLabel, versionLabel } from "../lib/work-labels";
import { dateRange, seriesAnchor, shortWorkLabel, yearRange } from "../lib/archive";
import type { CatalogItem } from "../types";
import { pageContext, localizeWork, workCount } from "../lib/i18n";

const { locale, base, assetBase, t } = pageContext(Astro.url);

const works = (catalogData as CatalogItem[]).map((work) => localizeWork(work, locale));

const representativeIds = ["b1-01", "b2-04", "b3-05", "b4-18"];
const volumeNames = ["第一册", "第二册", "第三册", "第四册"];
const volumeDescriptions = [
  "Pauline · Sheett · 5XD",
  "ZH1Z · Trigonometric Function",
  "PLY · Basketball",
  "BNU · Cambridge · Graduation",
];
const volumes = representativeIds.map((id, index) => {
  const catalogNumber = index + 1;
  const items = works.filter((work) => work.catalogNumber === catalogNumber);
  return {
    catalogNumber,
    name: volumeNames[index],
    description: volumeDescriptions[index],
    items,
    hero: works.find((work) => work.id === id)!,
    range: yearRange(items),
  };
});
const initial = volumes[0].hero;
const selectedIds = ["b1-01", "b1-18", "b2-04", "b2-05", "b3-05", "b3-09", "b4-12", "b4-15"];
const selectedWorks = selectedIds.map((id) => works.find((work) => work.id === id)!);
const collectionOrder = ["Trigonometric Function", "PLY", "Basketball", "BNU", "Cambridge", "Graduation"];
const collections = collectionOrder.map((name) => ({
  name,
  items: works.filter((work) => work.collection.includes(name)),
}));
const collectionNotes: Record<string, string> = {
  "Trigonometric Function": "α · β · θ · π",
  "PLY": "ONE · 0.7A · ZERO",
  "Basketball": "Under Armour SC IV · Air Jordan",
  "BNU": "BNU · Cambridge · Graduation",
  "Cambridge": "King · River Cam · Chilly",
  "Graduation": "Pauline LVIII",
};
---

<BaseLayout section="home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-card">
      <div class="hero-register" data-enter>
        <span>Pauline Archive</span>
        <span id="hero-catalog">{initial.catalog}</span>
      </div>
      <h1 id="home-title" data-enter>{t("宝莲图鉴")}</h1>
      <p class="hero-lead" data-enter>{t("四册、八十八件鞋履手稿，从 2017 年的第一双到 2024 年的毕业篇。")}</p>

      <a class="hero-specimen" id="hero-work-link" href={`${base}works/${initial.id}/`} data-enter aria-label={`${t("查看完整作品")} ${versionLabel(initial)}`}>
        <span class="hero-specimen-drift" data-parallax>
          <img id="hero-work-image" src={`${assetBase}${initial.image}`} alt={versionLabel(initial)} width="1600" height="1200" fetchpriority="high" />
        </span>
      </a>

      <div class="hero-work-meta" id="hero-work-meta" data-enter>
        <a id="hero-version" href={`${base}works/${initial.id}/`}>{shortWorkLabel(initial)}</a>
        <time id="hero-date" datetime={initial.creationDate ?? undefined}>{dateLabel(initial.creationDate, locale)}</time>
      </div>

      <div class="hero-volume-switch" role="group" aria-label={t("切换四册代表作品")} data-enter>
        {volumes.map((volume, index) => (
          <button
            type="button"
            data-volume={index}
            data-image={`${assetBase}${volume.hero.image}`}
            data-title={versionLabel(volume.hero)}
            data-short-title={shortWorkLabel(volume.hero)}
            data-date={dateLabel(volume.hero.creationDate, locale)}
            data-raw-date={volume.hero.creationDate ?? ""}
            data-url={`${base}works/${volume.hero.id}/`}
            data-catalog={volume.hero.catalog}
            aria-pressed={index === 0}
          >{t(volume.name)}</button>
        ))}
      </div>
      <a class="button hero-cta" href={`${base}gallery/`} data-enter>{t("进入照片墙")}</a>
    </div>
  </section>

  <section class="archive-intro section-frame" aria-labelledby="archive-intro-title" data-reveal-group>
    <div class="intro-heading">
      <h2 id="archive-intro-title" data-reveal>{t("八十八件，四册归档")}</h2>
    </div>
    <div class="archive-facts">
      <div data-reveal><strong>88</strong><span>{t("件电子化作品")}</span></div>
      <div data-reveal><strong>4</strong><span>{t("册原始图鉴")}</span></div>
      <div data-reveal><strong>2017–2024</strong><span>{t("创作年份")}</span></div>
      <div data-reveal><strong>2 + 6</strong><span>{t("两条支线与六组系列")}</span></div>
    </div>
  </section>

  <section class="volume-section section-frame" id="volumes" aria-labelledby="volume-title">
    <div class="section-heading-row">
      <h2 id="volume-title">{t("四册索引")}</h2>
    </div>
    <div class="volume-stack">
      {volumes.map((volume, index) => (
        <article class={`volume-band volume-tone-${index + 1}`} style={`--volume-index:${index}`} data-reveal-group>
          <a class="volume-tab" href={`${base}gallery/?catalog=${volume.catalogNumber}`}>{t(volume.name)}</a>
          <span class="volume-register">{t(volume.range)} · {workCount(volume.items.length, locale)}</span>
          <div class="volume-band-inner">
            <a class="volume-image" href={`${base}works/${volume.hero.id}/`} data-reveal>
              <img src={`${assetBase}${volume.hero.thumbnail}`} alt={versionLabel(volume.hero)} width="720" height="540" loading="lazy" decoding="async" />
            </a>
            <div class="volume-copy">
              <h3 data-reveal>{volume.hero.catalog}</h3>
              <p data-reveal>{volume.description}</p>
              <p class="volume-date-range" data-reveal>{t(dateRange(volume.items))}</p>
              <a class="text-link" href={`${base}gallery/?catalog=${volume.catalogNumber}`} data-reveal>{t("浏览本册")}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-series section-frame" aria-labelledby="home-series-title">
    <div class="series-display">
      <h2 id="home-series-title" data-reveal>{t("系列")}</h2>
      <a class="text-link" href={`${base}series/`} data-reveal>{t("查看完整系列线")}</a>
    </div>
    <div class="series-accordion" data-reveal-group>
      {collections.map((collection, index) => (
        <details data-animate open={index === 0} data-reveal>
          <summary><span>{collection.name}</span><span>{workCount(collection.items.length, locale)} <span aria-hidden="true">+</span></span></summary>
          <div class="details-content">
            <p>{collectionNotes[collection.name]}</p>
            <a href={`${base}series/#${seriesAnchor(collection.name)}`}>{t("进入系列")}</a>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="selected-works section-frame" aria-labelledby="selected-title" data-reveal-group>
    <div class="section-heading-row">
      <h2 id="selected-title" data-reveal>{t("作品选页")}</h2>
      <a class="text-link" href={`${base}gallery/`} data-reveal>{t("查看全部 88 件")}</a>
    </div>
    <div class="selected-grid">
      {selectedWorks.map((work, index) => (
        <a class={`selected-work selected-tone-${index % 4}`} href={`${base}works/${work.id}/`} data-reveal>
          <span class="selected-image"><img src={`${assetBase}${work.thumbnail}`} alt={versionLabel(work)} width="720" height="540" loading="lazy" decoding="async" /></span>
          <span class="selected-label">
            <span>{shortWorkLabel(work)}</span>
            <span>{work.catalog}</span>
            <time datetime={work.creationDate ?? undefined}>{dateLabel(work.creationDate, locale)}</time>
          </span>
        </a>
      ))}
    </div>
  </section>


  <script>
    import { gsap } from "gsap";

    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-volume]");
    const image = document.querySelector<HTMLImageElement>("#hero-work-image");
    const specimen = document.querySelector<HTMLAnchorElement>("#hero-work-link");
    const version = document.querySelector<HTMLAnchorElement>("#hero-version");
    const date = document.querySelector<HTMLTimeElement>("#hero-date");
    const catalog = document.querySelector<HTMLElement>("#hero-catalog");
    const meta = document.querySelector<HTMLElement>("#hero-work-meta");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!image || !specimen || !version || !date || !catalog || !meta || button.getAttribute("aria-pressed") === "true") return;
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));

        const update = () => {
          image.src = button.dataset.image ?? "";
          image.alt = button.dataset.title ?? "";
          specimen.href = button.dataset.url ?? "";
          specimen.setAttribute("aria-label", button.dataset.title ?? "Pauline");
          version.href = button.dataset.url ?? "";
          version.textContent = button.dataset.shortTitle ?? "";
          date.textContent = button.dataset.date ?? "";
          date.dateTime = button.dataset.rawDate ?? "";
          catalog.textContent = button.dataset.catalog ?? "";
        };

        gsap.killTweensOf([image, meta]);
        if (reduced.matches) {
          update();
          gsap.set([image, meta], { clearProps: "opacity,transform" });
          return;
        }
        update();
        gsap.fromTo([image, meta], { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.32, ease: "power2.out", clearProps: "opacity,transform" });
      });
    });
  </script>
</BaseLayout>
