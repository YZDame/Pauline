---
import { pageContext } from "../lib/i18n";
const { t } = pageContext(Astro.url);

interface Props {
  base: string;
}
const { base } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-card" data-reveal-group>
    <div class="footer-message" data-reveal>
      <h2>{t("宝莲图鉴")}</h2>
    </div>
    <nav class="footer-links" aria-label={t("页脚导航")} data-reveal>
      <a href={`${base}timeline/`}>{t("时间线")}</a>
      <a href={`${base}series/`}>{t("系列线")}</a>
      <a href={`${base}gallery/`}>{t("全部 88 件作品")}</a>
      <a href="https://github.com/YZDame/pauline" target="_blank" rel="noreferrer">GitHub ↗</a>
    </nav>
    <div class="footer-imprint" data-reveal>
      <span>2017–2024</span>
      <span>{t("作品与图像保留全部权利")}</span>
    </div>
  </div>
</footer>
